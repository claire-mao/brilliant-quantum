# Copy to .env.local (git-ignored). Never commit real values.

# --- Firebase (client-safe; these are public identifiers by design) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only AI keys (no NEXT_PUBLIC_ prefix; read only inside app/api/**) ---

# Hints / practice questions (OpenAI-compatible). Optional: handwritten fallbacks are used when missing.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Guide Wizard (/api/wizard) and Adaptive Teach-Back Tutor: Anthropic Claude (https://console.anthropic.com).
# Optional: handwritten wizard fallbacks and a rubric-based offline tutor are used when missing.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Teach-Back speech-to-text (Deepgram). Optional: learners can type instead when missing.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Teach-Back "Listen" button (ElevenLabs TTS). Optional: the button hides when missing.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
